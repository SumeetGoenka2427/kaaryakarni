APP_NAME="Khandelwal Samaj Jaipur"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8000

# Website languages: English (default, no URL prefix) and Hindi (/hi prefix)
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL / MariaDB (utf8mb4 is required for Hindi text)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kaaryakarni
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production (HTTPS only cookies)
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Admin session idle timeout in minutes
ADMIN_IDLE_TIMEOUT=30

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Use "redis" in production if available
CACHE_STORE=file
CACHE_PREFIX=ksj_

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@example.org"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# SMS / OTP
# SMS_DRIVER=log writes OTPs to storage/logs/otp.log for LOCAL development
# only. The application refuses to boot with SMS_DRIVER=log in production.
# ---------------------------------------------------------------------------
SMS_DRIVER=log
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_OTP_TEMPLATE_ID=

OTP_LENGTH=6
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_MOBILE_PER_HOUR=5
OTP_MAX_SENDS_PER_IP_PER_HOUR=20

# ---------------------------------------------------------------------------
# Payments (online payments are verified server-side via signature + webhook)
# ---------------------------------------------------------------------------
PAYMENT_DRIVER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# First super-admin, created by the ProductionSeeder (change after first login)
# ---------------------------------------------------------------------------
ADMIN_SEED_NAME="Samaj Admin"
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_EMAIL=admin@example.org
ADMIN_SEED_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
